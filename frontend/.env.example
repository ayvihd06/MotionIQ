# MotionIQ Frontend Environment Variables

# For local development (proxied through Vite dev server):
# Leave empty or set to '/api'
VITE_API_URL=/api

# For production deployment with split architecture (Vercel Frontend -> Render Backend):
# Set this to your live Render backend URL:
# VITE_API_URL=https://motioniq-api.onrender.com/api
