# MotionIQ Environment Configuration

# Database Configuration (PostgreSQL)
# Local development database
DATABASE_URL=postgresql://motioniq_user:motioniq_password@localhost:5432/motioniq_db

# Security & Authentication
# Replace this with a strong random secret in your actual .env file
SECRET_KEY=replace-with-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
AUTH_COOKIE_NAME=motioniq_session
AUTH_COOKIE_SECURE=false

# Privacy & Video Lifecycle
# Videos are deleted after analysis by default
VIDEO_RETENTION_DEFAULT=false

# Server Configuration
HOST=0.0.0.0
PORT=8000
